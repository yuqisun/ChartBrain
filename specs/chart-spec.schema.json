{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartbrain.dev/specs/chart-spec.schema.json",
  "title": "ChartBrain Neutral Chart Spec (v0.1)",
  "description": "ChartBrain neutral chart spec: library-agnostic intermediate representation. Narrow schema: enums everywhere, additionalProperties:false, fields may reference only original columns or columns produced/kept by prior transforms. See docs/design.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chart", "encodings"],
  "properties": {
    "schema_version": { "const": 1 },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "description": "Controlled chart-type whitelist (MVP: first five Highcharts types, D11)",
          "enum": ["bar", "line", "pie", "scatter", "area"]
        },
        "title": { "type": "string", "maxLength": 200 }
      }
    },
    "transform_plan": {
      "description": "Declarative transform plan. Omit = use raw data as-is. Steps run in order; output of one step is the input of the next.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" },
          "maxItems": 20
        }
      }
    },
    "encodings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/encoding" },
        "y": { "$ref": "#/$defs/encoding" },
        "series": { "$ref": "#/$defs/encoding" }
      }
    }
  },
  "$defs": {
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value_type": {
          "description": "Field semantics hint (helps converter/SDK choose axes/scales; never a library dialect)",
          "enum": ["categorical", "numeric", "temporal"]
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/op_filter" },
        { "$ref": "#/$defs/op_aggregate" },
        { "$ref": "#/$defs/op_sort" },
        { "$ref": "#/$defs/op_limit" },
        { "$ref": "#/$defs/op_derive" },
        { "$ref": "#/$defs/op_binTime" }
      ]
    },
    "scalar_or_list": {
      "oneOf": [
        { "type": ["number", "string", "boolean"] },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["number", "string"] }
        }
      ]
    },
    "op_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field", "operator"],
      "properties": {
        "op": { "const": "filter" },
        "field": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "between", "in", "contains"]
        },
        "value": { "$ref": "#/$defs/scalar_or_list" },
        "values": { "$ref": "#/$defs/scalar_or_list" }
      }
    },
    "op_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measures"],
      "properties": {
        "op": { "const": "aggregate" },
        "group_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 8
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/measure" }
        }
      }
    },
    "measure": {
      "description": "field is optional and only allowed when agg=count (counts rows); other aggregations must reference a column existing in the current table.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agg", "as"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "agg": { "enum": ["sum", "avg", "count", "countDistinct", "min", "max"] },
        "as": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "op_sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "by"],
      "properties": {
        "op": { "const": "sort" },
        "by": { "type": "string", "minLength": 1 },
        "order": { "enum": ["asc", "desc"], "default": "asc" }
      }
    },
    "op_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "n"],
      "properties": {
        "op": { "const": "limit" },
        "n": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "operand": {
      "description": "derive 的操作数：引用现有列或数字常量。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": { "field": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": { "value": { "type": "number" } }
        }
      ]
    },
    "op_derive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "as", "left", "operator", "right"],
      "properties": {
        "op": { "const": "derive" },
        "as": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "left": { "$ref": "#/$defs/operand" },
        "operator": { "enum": ["add", "subtract", "multiply", "divide"] },
        "right": { "$ref": "#/$defs/operand" }
      }
    },
    "op_binTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field", "granularity", "as"],
      "properties": {
        "op": { "const": "binTime" },
        "field": { "type": "string", "minLength": 1 },
        "granularity": { "enum": ["month", "quarter", "year"] },
        "as": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    }
  }
}
