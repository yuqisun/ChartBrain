# ChartBrain server 环境变量模板。
# 用法：复制为 server/.env 并填入你的 key（.env 已被 .gitignore 忽略，不会入库）。

# LLM Provider：mock（默认，无需 key）| openai-compatible（走真实模型）
CHARTBRAIN_LLM_PROVIDER=mock

# OpenAI 兼容端点（DeepSeek 示例；换其他厂商改这里）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHARTBRAIN_OPENAI_MODEL=deepseek-chat
